from "std" import *
gnd = dgnd()
def f1():
    branch:
        wire right 100 down 100
        add res(1k)
        wire down 100
        to gnd
def f2():
    branch:
        wire right 100 down 100
        add res(1k)
        wire down 100
        to gnd

at gnd
wire up 100
f1()
wire up 100
f2()
wire up 100
add res(3k)

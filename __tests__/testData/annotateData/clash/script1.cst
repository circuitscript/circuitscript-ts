from "std" import *
gnd = dgnd()
def stage():
    branch:
        wire right 100 down 100
        add res(1k)
        wire down 100
        to gnd

at gnd
wire up 100
add res(10k)
wire up 100
stage()
wire up 100
stage()
wire up 100
for i in range(0, 3):
    branch:
        wire right (200*i) down 100
        add res(5k)
        wire down 100
        to gnd

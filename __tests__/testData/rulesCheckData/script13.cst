from "std" import *
vcc = supply("VCC")
gnd = dgnd()

src = create component:
    pins: 2
    display: create graphic:
        hpin: 1, "A", "power_output", -100, 0, 100, display_id=false
        hpin: 2, "B", "power_output", -100, 50, 100, display_id=false

gnd_ref = create component:
    pins: 1
    display: create graphic:
        vpin: 1, "1", "power_reference", 0, -50, 50, display_id=false

at gnd_ref
wire down 100
to gnd

at vcc
wire right 100
to src pin 1

from "std" import *

v5 = supply("5V")
gnd = dgnd()

at v5
wire down 100
add res(10)
wire down 100
to gnd

at v5
wire down 100
add res(100)
wire down 100
to gnd

at v5
wire down 100
add res(33)
wire down 100
to gnd

at v5
wire down 100
add res(1k)
wire down 100
to gnd

at v5
wire down 100
add res(47)
wire down 100
to gnd

set: "mpn", "manufacturer":
    type: "res", value:
        10: "PART-RES-10R", "MAKER1"
        100: "PART-RES-100R", "MAKER1"
        33: "PART-RES-33R", "MAKER2"
        1k: "PART-RES-1K", "MAKER3"

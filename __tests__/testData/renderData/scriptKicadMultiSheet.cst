from "std" import *
document.sheet_type = sheet_A6()

vcc = net("3v3")
gnd = dgnd()

sheet:
    ..title = "Power Supply"
    at vcc
    wire right 100 add res(1k)
    wire right 100 down 100
    to gnd

sheet:
    ..title = "Output Stage"
    at vcc
    wire right 100 add res(2k)
    wire right 100 down 100
    to gnd

sheet:
    at vcc
    wire right 100 add res(3k)
    wire right 100 down 100
    to gnd

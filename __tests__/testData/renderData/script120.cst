# KiCad export: custom symbol with named pins

from "std" import *
vcc = supply("VCC")
gnd = dgnd()

reg = create component:
    pins:
        1: "VIN"
        2: "GND"
        3: "OUT"
        4: "EN"
    arrange:
        left:   1, 4
        right:  3
        bottom: 2

at vcc
wire down 100
branch:
    wire down 100
    to reg pin 1

wire auto
to reg pin 4

at reg pin 3
wire right 100
to vcc

at reg pin 2
wire down 100
to gnd

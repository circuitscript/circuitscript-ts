from "std" import *

erc_set("UNCONNECTED-PIN", "error")
erc_set("PIN-TYPE-PASSIVE-ONLY", "info")
erc_set("POWER-NET-UNUSED", "off")

v5 = supply("5V")
gnd = dgnd()

tmp = create component:
    pins: 6
    arrange:
        left: 1,2,3
        right: 4,5,6

at v5
wire down 100 right 100
to tmp pin 1

at res(10k) pin 1
wire down 50
to res(10k) pin 1
